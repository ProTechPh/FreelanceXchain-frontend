  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/*.test.mjs",
    "test:e2e": "playwright test",
    "test:auth": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/auth-contract.test.mjs",
    "test:csrf": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/csrf-token.test.mjs",
    "test:project-submission": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/project-submission.test.mjs",
    "test:proposal-submission": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/proposal-submission.test.mjs",
    "test:project-actions": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/project-actions.test.mjs",
    "test:proposal-management": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/proposal-management.test.mjs",
    "test:dashboard-message-route": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/lib/dashboard-message-route.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify:tokens": "node scripts/verify-tokens.mjs",
    "verify": "pnpm verify:contrast && pnpm verify:tokens"
  },
